{
  "name": "collective-social-api",
  "version": "1.0.0",
  "description": "API for the Collective social application",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "lexgen": "lex gen-server ./src/lexicon ./lexicons/*",
    "make-admin": "ts-node scripts/makeAdmin.ts",
    "test:integration": "vitest run"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@atproto/api": "^0.18.3",
    "@atproto/common": "^0.5.1",
    "@atproto/lexicon": "^0.5.2",
    "@atproto/oauth-client-node": "^0.3.11",
    "@atproto/sync": "^0.1.38",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "envalid": "^8.1.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.2",
    "helmet": "^8.1.0",
    "http-terminator": "^3.2.0",
    "iron-session": "^8.0.4",
    "kysely": "^0.28.14",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.9.7",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "vite": "^7.3.2",
    "rollup": "^4.59.0",
    "postcss": "^8.5.10",
    "vitest": {
      "picomatch": "^4.0.4"
    },
    "nodemon": {
      "minimatch": "^3.1.3",
      "brace-expansion": "^1.1.13"
    },
    "minimatch": {
      "brace-expansion": "^1.1.13"
    },
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "@ts-morph/common": {
      "minimatch": "^9.0.7"
    },
    "@atproto/xrpc-server": {
      "path-to-regexp": "0.1.13"
    },
    "router": {
      "path-to-regexp": "^8.4.0"
    }
  }
}
