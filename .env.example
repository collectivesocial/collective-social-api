# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_db

# OAuth Configuration
SERVICE_URL=http://localhost:3000
PDS_URL=https://bsky.social
PLC_URL=https://plc.directory

# May be generated with `openssl rand -base64 33`
COOKIE_SECRET=change-this-to-a-random-secret-at-least-32-characters-long

# May be generated with `./bin/gen-jwk` (requires `npm install` once first)
# PRIVATE_KEYS=[]

# External API Keys
# Get your free OMDB API key from: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-api-key-here

# OpenSocial Integration
# Register an app at your OpenSocial instance to get these credentials
OPENSOCIAL_API_URL=http://127.0.0.1:3001
OPENSOCIAL_API_KEY=your-opensocial-api-key-here

# CORS - Frontend origin allowed in production
# In production set to e.g. https://app.collectivesocial.app
# In development this is ignored (localhost origins are allowed automatically)
CORS_ORIGIN=http://127.0.0.1:5173
