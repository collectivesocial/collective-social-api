# Collective MCP Server Environment Configuration

# Required: URL of the Collective Social API
COLLECTIVE_API_URL=http://localhost:3000

# Required: Bearer token for authenticating with the Collective API
# This is the user's session token from Collective
COLLECTIVE_API_TOKEN=your-collective-session-token

# Optional: Port for the MCP server (default: 3100)
MCP_PORT=3100

# Required in production: Token that MCP clients must provide
# In development, auth is optional if this is not set
MCP_AUTH_TOKEN=your-mcp-auth-secret

# Optional: CORS allowed origins (default: *)
MCP_ALLOWED_ORIGINS=*
